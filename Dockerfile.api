FROM python:3.12-slim

WORKDIR /app

# Install system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git curl && \
    rm -rf /var/lib/apt/lists/*

# Install Python deps (FinSight + Prometheus instrumentation)
COPY finsight/requirements.txt requirements-finsight.txt
RUN pip install --no-cache-dir --timeout=120 -r requirements-finsight.txt
RUN pip install --no-cache-dir prometheus-fastapi-instrumentator

# Copy FinSight project files
COPY finsight/ml/ ml/
COPY finsight/api/ api/
COPY finsight/dbt_project/ dbt_project/
COPY finsight/data/raw/ data/raw/
COPY finsight/scripts/ scripts/
COPY finsight/tests/ tests/

# Copy PipelineX metrics overlay
COPY overlay/metrics.py /app/overlay/metrics.py

# Create data directory
RUN mkdir -p data

# Environment variables for paths inside container
ENV DUCKDB_PATH=/app/data/warehouse.duckdb
ENV CSV_PATH=/app/data/raw/transactions.csv

# Startup script: build pipeline if warehouse doesn't exist, then serve API
COPY finsight/scripts/docker_entrypoint.sh /app/scripts/docker_entrypoint.sh
RUN chmod +x /app/scripts/docker_entrypoint.sh

# Patch entrypoint to use the instrumented app instead of the plain one
RUN sed -i 's|uvicorn api.main:app|uvicorn overlay.metrics:app|g' /app/scripts/docker_entrypoint.sh

EXPOSE 8000

CMD ["/app/scripts/docker_entrypoint.sh"]
